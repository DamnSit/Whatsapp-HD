{
  "name": "whatsapp-hd",
  "version": "1.0.3",
  "license": "GPL-3.0-only OR AGPL-3.0-only",
  "author": "XurXuo (DamnSit)",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "description": "Interactive Termux dashboard and CLI for WhatsApp image/video Status with Baileys",
  "bin": {
    "whatsapp-hd": "index.js"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "scripts/prepare-bundle.js",
    "LICENSE",
    "LICENSE-GPL-3.0.txt",
    "LICENSE-AGPL-3.0.txt",
    "NOTICE",
    "docs/security-review.md",
    "docs/validation.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamnSit/Whatsapp-HD.git"
  },
  "homepage": "https://github.com/DamnSit/Whatsapp-HD#readme",
  "bugs": {
    "url": "https://github.com/DamnSit/Whatsapp-HD/issues"
  },
  "keywords": [
    "whatsapp",
    "termux",
    "tui",
    "status",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "node index.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "pack:release": "node scripts/pack-release.js",
    "prepack": "node scripts/prepare-bundle.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "jimp": "1.6.1",
    "pino": "^9.6.0"
  },
  "bundleDependencies": [
    "jimp"
  ],
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
